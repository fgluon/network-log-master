[Unit]
Description=AI Results Validation Gate
After=local-fs.target

[Service]
Type=oneshot
User=ai_results_gate
Group=ai_results_gate

ExecStart=/usr/local/sbin/ai-results-gate

UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes

ProtectSystem=strict
ProtectHome=yes

ReadWritePaths=/var/spool/ai-results/incoming
ReadWritePaths=/var/spool/ai-results/ready
ReadWritePaths=/var/spool/ai-results/rejected

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictNamespaces=yes
LockPersonality=yes

CapabilityBoundingSet=
AmbientCapabilities=
